    "# 分析顶级表现的类别\n",
    "def analyze_top_performing_classes(class_f1, class_names, top_n=10):\n",
    "    \"\"\"\n",
    "    分析和可视化表现最好的类别\n",
    "    \"\"\"\n",
    "    # 找出非零F1分数的类别\n",
    "    non_zero_indices = np.where(class_f1 > 0)[0]\n",
    "    non_zero_f1 = class_f1[non_zero_indices]\n",
    "    \n",
    "    # 获取表现最好的前N个类别\n",
    "    if len(non_zero_indices) > 0:\n",
    "        top_indices = non_zero_indices[np.argsort(non_zero_f1)[::-1][:top_n]]\n",
    "        top_scores = class_f1[top_indices]\n",
    "        \n",
    "        # 显示这些类别的名称和分数\n",
    "        print(f\"\\n表现最好的{len(top_indices)}个类别:\")\n",
    "        for i, idx in enumerate(top_indices):\n",
    "            print(f\"{i+1}. {class_names[idx]} - F1: {class_f1[idx]:.4f}\")\n",
    "        \n",
    "        # 可视化\n",
    "        plt.figure(figsize=(10, 6))\n",
    "        plt.bar(range(len(top_indices)), top_scores)\n",
    "        plt.xticks(range(len(top_indices)), [class_names[i] for i in top_indices], rotation=45, ha='right')\n",
    "        plt.xlabel('Class')\n",
    "        plt.ylabel('F1 Score')\n",
    "        plt.title('Top Performing Classes')\n",
    "        plt.ylim(0, 1.05)\n",
    "        plt.grid(True, linestyle='--', alpha=0.7)\n",
    "        plt.tight_layout()\n",
    "        \n",
    "        return top_indices, top_scores\n",
    "    else:\n",
    "        print(\"没有类别有非零F1分数\")\n",
    "        return [], []\n",
    "\n",
    "# 分析表现最差的类别\n",
    "def analyze_worst_performing_classes(class_f1, class_names, bottom_n=10):\n",
    "    \"\"\"\n",
    "    分析和可视化表现最差的类别\n",
    "    \"\"\"\n",
    "    # 找出非零F1分数的类别（避免那些没有样本的类别）\n",
    "    non_zero_indices = np.where(class_f1 > 0)[0]\n",
    "    non_zero_f1 = class_f1[non_zero_indices]\n",
    "    \n",
    "    # 获取表现最差的前N个类别\n",
    "    if len(non_zero_indices) > 0:\n",
    "        bottom_indices = non_zero_indices[np.argsort(non_zero_f1)[:min(bottom_n, len(non_zero_indices))]]\n",
    "        bottom_scores = class_f1[bottom_indices]\n",
    "        \n",
    "        # 显示这些类别的名称和分数\n",
    "        print(f\"\\n表现最差的{len(bottom_indices)}个类别:\")\n",
    "        for i, idx in enumerate(bottom_indices):\n",
    "            print(f\"{i+1}. {class_names[idx]} - F1: {class_f1[idx]:.4f}\")\n",
    "        \n",
    "        # 可视化\n",
    "        plt.figure(figsize=(10, 6))\n",
    "        plt.bar(range(len(bottom_indices)), bottom_scores)\n",
    "        plt.xticks(range(len(bottom_indices)), [class_names[i] for i in bottom_indices], rotation=45, ha='right')\n",
    "        plt.xlabel('Class')\n",
    "        plt.ylabel('F1 Score')\n",
    "        plt.title('Worst Performing Classes')\n",
    "        plt.ylim(0, 0.5)  # 调整Y轴以便更好地查看低分数\n",
    "        plt.grid(True, linestyle='--', alpha=0.7)\n",
    "        plt.tight_layout()\n",
    "        \n",
    "        return bottom_indices, bottom_scores\n",
    "    else:\n",
    "        print(\"没有类别有非零F1分数\")\n",
    "        return [], []\n",
    "\n",
    "# 分析类别性能\n",
    "print(\"分析类别性能...\")\n",
    "# 分析表现最好的类别\n",
    "top_indices, _ = analyze_top_performing_classes(test_results['class_f1'], class_names, top_n=10)\n",
    "plt.savefig(os.path.join(SAVE_PATH, 'top_performing_classes.png'), dpi=300, bbox_inches='tight')\n",
    "plt.show()\n",
    "\n",
    "# 分析表现最差的类别\n",
    "bottom_indices, _ = analyze_worst_performing_classes(test_results['class_f1'], class_names, bottom_n=10)\n",
    "plt.savefig(os.path.join(SAVE_PATH, 'worst_performing_classes.png'), dpi=300, bbox_inches='tight')\n",
    "plt.show()"
    "# 获取最佳模型函数\n",
    "def get_best_model(metrics_list, epoch_list, save_path, metric='acc', del_others=True):\n",
    "    \"\"\"\n",
    "    通过指定评估指标找到最佳模型\n",
    "    \n",
    "    参数:\n",
    "        metrics_list: 指标列表（如准确率、F1或AUC-PR）\n",
    "        epoch_list: 对应的epoch列表\n",
    "        save_path: 模型保存路径\n",
    "        metric: 要使用的指标，默认为'acc'，可选'f1_macro'或'kappa'\n",
    "        del_others: 是否删除其他模型\n",
    "    \n",
    "    返回:\n",
    "        best_model_path: 最佳模型路径\n",
    "    \"\"\"\n",
    "    metrics_list = np.array(metrics_list)\n",
    "    epoch_list = np.array(epoch_list)\n",
    "    best_index = np.argwhere(metrics_list == np.max(metrics_list))[-1].item()\n",
    "    best_epoch = epoch_list[best_index]\n",
    "    best_metric = metrics_list[best_index]\n",
    "    \n",
    "    # 根据使用的指标查找对应模型文件\n",
    "    if metric == 'f1_macro':\n",
    "        pattern = f\"epoch_{best_epoch}_*_f1_{best_metric:.4f}.pth\"\n",
    "    elif metric == 'kappa':\n",
    "        pattern = f\"epoch_{best_epoch}_*.pth\"\n",
    "    else:  # 默认使用acc\n",
    "        pattern = f\"epoch_{best_epoch}_acc_{best_metric:.4f}_*.pth\"\n",
    "    \n",
    "    matching_files = glob.glob(os.path.join(save_path, pattern))\n",
    "    if not matching_files:\n",
    "        # 备用搜索方式\n",
    "        all_model_files = glob.glob(os.path.join(save_path, \"*.pth\"))\n",
    "        for file in all_model_files:\n",
    "            if f\"epoch_{best_epoch}_\" in file:\n",
    "                matching_files.append(file)\n",
    "    \n",
    "    if not matching_files:\n",
    "        raise FileNotFoundError(f\"找不到对应的模型文件: {pattern}\")\n",
    "    \n",
    "    best_model_path = matching_files[0]\n",
    "    print(f\"最佳模型 ({metric}={best_metric:.4f}): {os.path.basename(best_model_path)}\")\n",
    "    \n",
    "    # 删除其他模型\n",
    "    if del_others:\n",
    "        for f in os.listdir(save_path):\n",
    "            if f.endswith('.pth') and os.path.join(save_path, f) != best_model_path:\n",
    "                os.remove(os.path.join(save_path, f))\n",
    "    \n",
    "    return best_model_path"
   ]
  },
