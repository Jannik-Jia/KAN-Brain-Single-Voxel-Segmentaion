    "# 计算类别权重函数\n",
    "def calculate_class_weights(train_labels):\n",
    "    \"\"\"\n",
    "    计算类别权重，解决不平衡问题\n",
    "    \n",
    "    参数:\n",
    "        train_labels: 训练集标签\n",
    "        \n",
    "    返回:\n",
    "        weights: 类别权重张量\n",
    "    \"\"\"\n",
    "    # 统计每个类别的样本数（排除背景标签-1）\n",
    "    labels = train_labels[train_labels >= 0]\n",
    "    class_counts = np.bincount(labels.astype(int))\n",
    "    \n",
    "    # 确保每个类别至少有一个样本\n",
    "    class_counts = np.where(class_counts == 0, 1, class_counts)\n",
    "    \n",
    "    # 计算权重（反比于频率）\n",
    "    weights = 1.0 / class_counts\n",
    "    \n",
    "    # 归一化权重\n",
    "    weights = weights / weights.sum() * len(weights)\n",
    "    \n",
    "    # 扩展到完整的类别集合（包括可能缺失的类别）\n",
    "    full_weights = np.zeros(NUM_CLASS)\n",
    "    full_weights[:len(weights)] = weights\n",
    "    \n",
    "    # 将缺失类别的权重设为平均值\n",
    "    if len(weights) < NUM_CLASS:\n",
    "        full_weights[len(weights):] = weights.mean()\n",
    "    \n",
    "    return torch.FloatTensor(full_weights)"
   ]
  },
