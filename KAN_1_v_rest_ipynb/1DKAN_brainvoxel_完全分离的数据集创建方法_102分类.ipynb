    "# 计算和可视化每个类的准确率与样本数量的关系\n",
    "def analyse_class_accuracy_vs_frequency(pred_map, gt_map, label_mask=None):\n",
    "    \"\"\"\n",
    "    分析每个类别的准确率与该类别的频率的关系\n",
    "    \n",
    "    参数:\n",
    "        pred_map: 预测标签图\n",
    "        gt_map: 真实标签图\n",
    "        label_mask: 用于筛选的掩码，None表示使用所有非零标签\n",
    "    \"\"\"\n",
    "    if label_mask is None:\n",
    "        label_mask = gt_map > 0\n",
    "    \n",
    "    # 筛选有效位置\n",
    "    gt_values = gt_map[label_mask]\n",
    "    pred_values = pred_map[label_mask]\n",
    "    \n",
    "    # 计算每个类别的频率和准确率\n",
    "    classes, counts = np.unique(gt_values, return_counts=True)\n",
    "    \n",
    "    class_accuracies = []\n",
    "    \n",
    "    for cls, count in zip(classes, counts):\n",
    "        # 找出当前类别的所有位置\n",
    "        cls_mask = gt_values == cls\n",
    "        # 计算准确率\n",
    "        accuracy = np.mean(pred_values[cls_mask] == cls)\n",
    "        class_accuracies.append(accuracy)\n",
    "    \n",
    "    # 可视化\n",
    "    plt.figure(figsize=(12, 8))\n",
    "    plt.scatter(counts, class_accuracies, alpha=0.7)\n",
    "    \n",
    "    # 添加类别标签\n",
    "    for i, (cls, count, acc) in enumerate(zip(classes, counts, class_accuracies)):\n",
    "        plt.annotate(f\"Class {cls}\", (count, acc), xytext=(5, 0), \n",
    "                    textcoords='offset points', fontsize=8)\n",
    "    \n",
    "    # 添加趋势线\n",
    "    z = np.polyfit(np.log(counts), class_accuracies, 1)\n",
    "    p = np.poly1d(z)\n",
    "    x_range = np.logspace(np.log10(min(counts)), np.log10(max(counts)), 100)\n",
    "    plt.plot(x_range, p(np.log(x_range)), \"r--\")\n",
    "    \n",
    "    plt.xscale('log')\n",
    "    plt.xlabel('Number of Samples (log scale)')\n",
    "    plt.ylabel('Class Accuracy')\n",
    "    plt.title('Class Accuracy vs. Sample Frequency')\n",
    "    plt.grid(True, alpha=0.3)\n",
    "    plt.ylim(-0.05, 1.05)\n",
    "    \n",
    "    # 计算并显示相关系数\n",
    "    correlation = np.corrcoef(np.log(counts), class_accuracies)[0, 1]\n",
    "    plt.figtext(0.15, 0.85, f\"Log-Correlation: {correlation:.4f}\", fontsize=12)\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    \n",
    "    return classes, counts, class_accuracies\n",
    "\n",
    "# 分析测试集上的类别准确率与频率\n",
    "print(\"分析类别准确率与频率的关系...\")\n",
    "classes, counts, accuracies = analyse_class_accuracy_vs_frequency(pred_map, label)\n",
    "plt.savefig(os.path.join(SAVE_PATH, 'class_accuracy_vs_frequency.png'), dpi=300, bbox_inches='tight')\n",
    "plt.show()"
   ]
