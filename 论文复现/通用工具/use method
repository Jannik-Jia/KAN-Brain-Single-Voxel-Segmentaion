## 2. 实验日志器 (experiment_logger.py)

```python
from experiment_logger import ExperimentLogger

# 1. 初始化
logger = ExperimentLogger(
    experiment_id=f"kan_multiclass_test{args.test_subject}",
    method_name="KAN Multiclass (Spline Order 3)",
    method_key="kan_multiclass",
    family="kan",
    subfamily="kan_multiclass"
)

# 2. 记录配置
logger.set_task(
    split_id=f"loo_subject_{args.test_subject}",
    train_sub=train_subject_names,
    test_sub=[test_subject_name]
)

logger.set_model_details(
    param_count_m=model_param_count / 1e6,
    input_dim=341,
    output_dim=102,
    kan_config={
        "grid_size": 5,
        "spline_order": 3,
        "base_activation": "silu"
    },
    dropout=0.1
)

logger.set_training_config(
    batch_size=args.batch_size,
    epochs=args.epochs,
    lr=args.learning_rate,
    optimizer="adam"
)

# 3. 记录结果
logger.data["results"]["global_metrics"] = trainer.best_test_metrics
logger.data["results"]["evaluated_split"] = "test"
logger.set_hardware(train_time_hours=train_time_hours)

# 4. 保存
logger.save(args.output_dir)
```

