{
    "project_name": "brain-mri-classification",
    "version": "1.0.0",
    
    "paths": {
        "data_dir": "data",
        "raw_data_dir": "data/raw",
        "processed_data_dir": "data/processed",
        "feature_subsets_dir": "data/feature_subsets",
        "results_dir": "results",
        "models_dir": "models",
        "logs_dir": "logs"
    },
    
    "data_processing": {
        "apply_normalization": true,
        "normalization_method": "standard",
        "handle_missing_values": true,
        "missing_value_strategy": "mean",
        "detect_outliers": true,
        "outlier_threshold": 3.0
    },
    
    "feature_groups": {
        "diffusion": {
            "index_range": [0, 14],
            "description": "包含AD, C_MD, C_M, RD, C_c, C_mu, FA, K_bulk, K_shear, V_MD, MD, V_iso, MK, V_shear, uFA, uK特征"
        },
        "cest": {
            "index_range": [225, 340],
            "description": "包含CEST频谱数据"
        },
        "qti": {
            "index_range": [15, 224],
            "description": "包含mdm_QTI_NII_mc_s_xps特征"
        }
    },
    
    "feature_importance": {
        "methods": ["rf", "mi", "permutation"],
        "rf_params": {
            "n_estimators": 100,
            "max_depth": 10,
            "random_state": 42,
            "n_jobs": -1
        },
        "importance_thresholds": [0.8, 0.9, 0.95, 0.99]
    },
    
    "feature_selection": {
        "apply_redundancy_removal": true,
        "correlation_threshold": 0.9,
        "min_feature_count": 10
    },
    
    "dimensionality_reduction": {
        "apply_pca": true,
        "pca_variance": 0.95,
        "apply_umap": true,
        "umap_params": {
            "n_components": 2,
            "n_neighbors": 15,
            "min_dist": 0.1,
            "random_state": 42
        }
    },
    
    "model_training": {
        "random_seed": 42,
        "train_ratio": 0.7,
        "val_ratio": 0.15,
        "test_ratio": 0.15,
        "cross_validation": {
            "enabled": true,
            "n_folds": 5,
            "stratify": true
        },
        "early_stopping": {
            "enabled": true,
            "patience": 10,
            "min_delta": 0.001
        }
    },
    
    "baseline_model": {
        "model_type": "deep_mlp",
        "hidden_dims": [2048, 1024, 512, 256, 128],
        "dropout_rate": 0.3,
        "use_residual": true,
        "use_self_attention": true,
        "use_feature_interaction": true,
        "num_attn_heads": 8,
        "attn_layers": [1, 3],
        "batch_size": 256,
        "learning_rate": 1e-4,
        "weight_decay": 1e-4,
        "optimizer": "adamw",
        "scheduler": "onecycle",
        "num_epochs": 100
    },
    
    "mfcan_model": {
        "diffusion_encoder": {
            "input_dim": 15,
            "hidden_dim": 64,
            "output_dim": 32,
            "dropout": 0.1
        },
        "qti_encoder": {
            "input_dim": 210,
            "hidden_dims": [768, 384],
            "output_dim": 192,
            "dropout": 0.3
        },
        "cest_encoder": {
            "input_dim": 116,
            "hidden_dim": 192,
            "output_dim": 96,
            "dropout": 0.5
        },
        "attention": {
            "feature_dim": 320,
            "num_classes": 102
        },
        "fusion": {
            "modal_dims": [32, 192, 96]
        },
        "main_classifier": {
            "input_dim": 320,
            "hidden_dim": 512,
            "num_classes": 102
        }
    }
}