{
    "model_type": "deep_mlp",
    "input_dim": 341,
    "hidden_dims": [2048, 1024, 512, 256, 128],
    "num_classes": 102,
    "dropout_rate": 0.3,
    "use_residual": true,
    "use_self_attention": true,
    "use_feature_interaction": true,
    "num_attn_heads": 8,
    "attn_layers": [1, 3],
    "dropout_rates": [0.2, 0.3, 0.4, 0.3, 0.2],
    
    "group_dims": {
        "diffusion": 15,
        "qti": 210,
        "cest": 116
    },
    "group_hidden_dims": {
        "diffusion": [128, 64],
        "qti": [512, 256],
        "cest": [384, 192]
    },
    "fusion_method": "attention",
    
    "num_epochs": 100,
    "batch_size": 256,
    "learning_rate": 1e-4,
    "weight_decay": 1e-4,
    "optimizer": "adamw",
    "scheduler": "onecycle",
    "criterion": "cross_entropy",
    "label_smoothing": 0.1,
    "use_class_weights": true,
    "early_stopping": 15,
    
    "preprocessed_data_path": "data/processed/preprocessed_data.h5",
    "save_dir": "results/baseline_deep_mlp"
}